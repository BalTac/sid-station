{
  "name": "sid-station",
  "version": "0.1.0",
  "description": "Native Windows Commodore 64 SID music player and HVSC browser powered by libsidplayfp",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck",
    "tauri": "tauri",
    "check": "cargo check --manifest-path src-tauri/Cargo.toml",
    "postinstall": "node scripts/copy-wasm.mjs"
  },
  "keywords": [
    "commodore-64",
    "c64",
    "sid",
    "hvsc",
    "psid",
    "rsid",
    "chiptune",
    "tauri",
    "react"
  ],
  "type": "module",
  "private": true,
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.26",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "libsidplayfp-wasm": "^1.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/cli": "^2.12.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.7"
  },
  "license": "GPL-2.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/BalTac/sid-station.git"
  },
  "author": "BalTac"
}
