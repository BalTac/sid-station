{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "SID Station",
  "version": "0.1.0",
  "identifier": "net.baltac.sidstation",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "SID Station",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#08070f"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "shortDescription": "Local HVSC browser and SID player",
    "longDescription": "SID Station - browse, search and play the High Voltage SID Collection from your own disk.",
    "copyright": "GPL-2.0-or-later. SID tunes remain copyright of their authors.",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "resources": [
      "resources/7z/*"
    ]
  }
}